# Telegram bot token from @BotFather
BOT_TOKEN=123456:your-bot-token-here

# Public URL where the FastAPI app + WebApp are served (Railway gives you this)
WEBAPP_URL=https://your-app.up.railway.app

# Your bot's @username (without the @), used to build spectator share links
BOT_USERNAME=your_bot

# Railway injects DATABASE_URL automatically when you attach a PostgreSQL plugin.
# For local dev, point it at your own Postgres instance:
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chess_tma

# Comma-separated list of Telegram user IDs allowed to act as bot admins
ADMIN_IDS=111111111,222222222
